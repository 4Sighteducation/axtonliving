---
import logoImg from '../assets/images/axton-logo.png';

const { current = 'home' } = Astro.props;

const links = [
  { href: '/', label: 'Home', id: 'home' },
  { href: '/about', label: 'Our Story', id: 'about' },
  { href: '/services', label: 'Services', id: 'services' },
];
---

<header class="site-header" id="header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Axton Living home">
      <img
        src={logoImg.src}
        alt="Axton Living"
        class="brand-logo"
        width={logoImg.width}
        height={logoImg.height}
        fetchpriority="high"
      />
    </a>
    <nav class="nav" aria-label="Primary">
      {
        links.map((link) => (
          <a class:list={['link', { active: current === link.id }]} href={link.href}>
            {link.label}
          </a>
        ))
      }
      <a class="nav-cta" href="/#contact">Get in touch</a>
    </nav>
  </div>
</header>

<script>
  (function () {
    const header = document.getElementById('header');
    const onScroll = function () {
      if (!header) return;
      if (window.scrollY > 30) header.classList.add('scrolled');
      else header.classList.remove('scrolled');
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>
