---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Axton Living | Property with purpose',
  description = 'Axton Living brings a fresh, refined approach to property — stylish, personal, and built on trust.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/axton-logo.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
