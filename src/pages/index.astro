---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
import RevealScript from '../components/RevealScript.astro';

const arrowIcon = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;

const servicesPreview = [
  {
    title: 'Property sourcing',
    text: '[Placeholder] Brief description of how Axton Living identifies investment opportunities across the North West and North East.',
  },
  {
    title: 'Renovation & refurbishment',
    text: '[Placeholder] Brief description of design-led property transformation — from tired stock to desirable homes.',
  },
  {
    title: 'Investor partnerships',
    text: '[Placeholder] Brief description of how investors can work with Axton Living on joint ventures and funded projects.',
  },
];

const galleryItems = [
  { label: 'Before & after — Project 01', variant: 'default' as const },
  { label: 'Before & after — Project 02', variant: 'pink' as const },
  { label: 'Before & after — Project 03', variant: 'default' as const },
  { label: 'Before & after — Project 04', variant: 'pink' as const },
];
---

<Layout
  title="Axton Living — Property Investment in the North West & North East"
  description="Axton Living Ltd helps property investors create value through considered, design-led development. Generate enquiries and build your presence in the property investment market."
>
  <Header current="home" />

  <main id="top">
    <section class="hero">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="hero-blob b1" data-parallax="0.18" aria-hidden="true"></div>
      <div class="hero-blob b2" data-parallax="-0.12" aria-hidden="true"></div>
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="eyebrow fade-stagger d1">Property investment</span>
          <h1>
            <span class="reveal-line"><span>[Placeholder headline]</span></span>
            <span class="reveal-line"><span>for the <em>North West</em> &amp; North East.</span></span>
          </h1>
          <p class="hero-lead fade-stagger d2">
            [Placeholder intro copy] Axton Living Ltd creates a professional presence in the
            property investment market — helping investors and developers turn overlooked
            properties into homes people want to live in.
          </p>
          <div class="hero-actions fade-stagger d3">
            <a href="#contact" class="btn btn-primary">
              Get in touch
              <Fragment set:html={arrowIcon} />
            </a>
            <a href="/services" class="btn btn-secondary">View services</a>
          </div>
        </div>
        <div class="hero-visual">
          <div class="hero-frame">
            <PlaceholderImage label="Hero image — your photo here" />
          </div>
        </div>
      </div>
    </section>

    <section class="intro">
      <div class="container intro-grid">
        <div class="intro-text">
          <span class="eyebrow" data-reveal>Welcome</span>
          <h2 data-reveal class="d1">[Placeholder section heading]</h2>
          <p data-reveal class="d2">
            [Placeholder body copy] This is sample text to show layout and tone. Catherine
            will review and replace this with her own words during the feedback stage.
          </p>
          <a href="/about" class="btn btn-secondary d2" data-reveal>Read our story</a>
        </div>
        <div class="intro-cards">
          {
            servicesPreview.map((item, i) => (
              <article class:list={['intro-card', i > 0 && 'd1']} data-reveal>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="gallery" id="gallery">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow" data-reveal>Portfolio</span>
          <h2 data-reveal class="d1">Before &amp; after gallery</h2>
          <p data-reveal class="d2">
            [Placeholder] Your phone photos and before/after project images will replace these
            placeholders. Each slot is sized for landscape before/after pairs.
          </p>
        </div>
        <div class="gallery-grid">
          {
            galleryItems.map((item) => (
              <div class="gallery-item clip">
                <PlaceholderImage label={item.label} variant={item.variant} />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        <span>Property investment</span><span>North West</span><span>North East</span><span>Design-led</span>
        <span>Property investment</span><span>North West</span><span>North East</span><span>Design-led</span>
      </div>
    </div>

    <section class="social">
      <div class="container social-inner">
        <span class="eyebrow" data-reveal>Connect</span>
        <h2 data-reveal class="d1">Social media feeds</h2>
        <p data-reveal class="d2">
          [Placeholder] Instagram and Facebook feeds will appear here once connected. This
          section keeps the site feeling active and personable.
        </p>
        <div class="social-placeholder d2" data-reveal aria-hidden="true">
          <div class="social-tile"></div>
          <div class="social-tile"></div>
          <div class="social-tile"></div>
          <div class="social-tile"></div>
        </div>
      </div>
    </section>

    <section class="contact" id="contact">
      <div class="container contact-inner">
        <span class="eyebrow" data-reveal style="justify-content: center">Get in touch</span>
        <h2 data-reveal class="d1">Ready to start a<br /><em>conversation?</em></h2>
        <p data-reveal class="d2">
          [Placeholder] Whether you are an investor exploring opportunities or looking for a
          considered property partner in the North West or North East, we would love to hear
          from you.
        </p>
        <div class="contact-actions d2" data-reveal>
          <a href="mailto:catherine.axton@gmail.com" class="btn btn-primary">Email Catherine</a>
          <a href="tel:07788438116" class="btn btn-secondary">Call 07788 438116</a>
        </div>
        <div>
          <a href="mailto:catherine.axton@gmail.com" class="contact-email">catherine.axton@gmail.com</a>
        </div>
        <p class="contact-note d2" data-reveal>
          <a href="/feedback">Complete the site feedback form</a> to help us refine this draft.
        </p>
      </div>
    </section>
  </main>

  <Footer />
  <RevealScript />
</Layout>
