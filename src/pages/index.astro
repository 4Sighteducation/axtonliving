---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    title: 'Property management',
    text: 'Thoughtful oversight of your home or portfolio — responsive, organised, and always personal.',
  },
  {
    title: 'Lettings & tenant care',
    text: 'Finding the right people for the right spaces, with clear communication at every step.',
  },
  {
    title: 'Portfolio guidance',
    text: 'Strategic advice shaped around your goals, with an eye for long-term value and peace of mind.',
  },
  {
    title: 'Concierge support',
    text: 'From maintenance to move-ins — a calm, capable hand when you need it most.',
  },
];

const values = [
  'A fresh perspective in a traditional industry',
  'Clear, honest communication — no jargon',
  'Detail-led care with a human touch',
  'Built for landlords, homeowners, and investors alike',
];
---

<Layout>
  <header class="site-header">
    <div class="container header-inner">
      <a href="#" class="brand" aria-label="Axton Living home">
        <img src="/axton-logo.png" alt="Axton Living" width="72" height="88" />
      </a>
      <nav class="nav" aria-label="Primary">
        <a href="#about">About</a>
        <a href="#services">Services</a>
        <a href="#approach">Approach</a>
        <a href="#contact" class="nav-cta">Get in touch</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="container hero-grid">
        <div class="hero-copy animate-in">
          <span class="section-label">Property with purpose</span>
          <h1>Where homes are cared for with intention</h1>
          <p class="hero-lead">
            Axton Living offers a refined approach to property — modern, approachable,
            and unmistakably personal. A feminine perspective in an industry that
            rarely makes space for one.
          </p>
          <div class="hero-actions">
            <a href="#contact" class="btn btn-primary">Start a conversation</a>
            <a href="#services" class="btn btn-secondary">Explore services</a>
          </div>
        </div>
        <div class="hero-visual animate-in-delay">
          <div class="hero-card">
            <img src="/axton-logo.png" alt="" width="220" height="268" class="hero-logo" />
            <p class="hero-card-tag">Est. 2026</p>
            <p class="hero-card-text">
              Stylish property services for people who value clarity, care, and confidence.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="about" class="about">
      <div class="container about-grid">
        <div>
          <span class="section-label">About Axton Living</span>
          <h2>A different kind of property business</h2>
        </div>
        <div class="about-copy">
          <p>
            Property is often presented as transactional and impersonal. Axton Living
            was founded to change that — bringing warmth, precision, and a distinctly
            modern sensibility to every client relationship.
          </p>
          <p>
            Whether you own one home or a growing portfolio, you deserve a partner
            who listens first, communicates clearly, and treats your property as if
            it were their own.
          </p>
        </div>
      </div>
    </section>

    <section id="services" class="services">
      <div class="container">
        <div class="section-head">
          <span class="section-label">What we offer</span>
          <h2>Services designed around you</h2>
          <p>
            Flexible support for landlords, homeowners, and investors — delivered
            with the same attention to detail throughout.
          </p>
        </div>
        <div class="service-grid">
          {services.map((service, index) => (
            <article class="service-card" style={`--delay: ${index * 0.08}s`}>
              <span class="service-number">{String(index + 1).padStart(2, '0')}</span>
              <h3>{service.title}</h3>
              <p>{service.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="approach" class="approach">
      <div class="container approach-grid">
        <div class="approach-panel">
          <span class="section-label">Our approach</span>
          <h2>Refined. Responsive. Real.</h2>
          <p>
            We believe great property service should feel effortless — even when
            the work behind it is anything but. That means proactive communication,
            elegant problem-solving, and a standard of care that stands apart.
          </p>
        </div>
        <ul class="value-list">
          {values.map((value) => (
            <li>{value}</li>
          ))}
        </ul>
      </div>
    </section>

    <section id="contact" class="contact">
      <div class="container contact-inner">
        <div class="contact-copy">
          <span class="section-label">Get in touch</span>
          <h2>Let&apos;s talk about your property</h2>
          <p>
            Whether you&apos;re exploring options or ready to get started, we&apos;d love
            to hear from you. Reach out and we&apos;ll respond personally.
          </p>
        </div>
        <div class="contact-card">
          <p class="contact-label">Email</p>
          <a href="mailto:hello@axtonliving.co.uk" class="contact-email">hello@axtonliving.co.uk</a>
          <p class="contact-note">
            Full site launching soon. Domain and email are ready — website coming next.
          </p>
          <a href="mailto:hello@axtonliving.co.uk" class="btn btn-primary">Send an email</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <img src="/axton-logo.png" alt="Axton Living" width="48" height="58" />
      <p>&copy; {new Date().getFullYear()} Axton Living. All rights reserved.</p>
    </div>
  </footer>
</Layout>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(12px);
    background: rgba(255, 250, 249, 0.88);
    border-bottom: 1px solid rgba(20, 70, 46, 0.08);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0;
    gap: 1rem;
  }

  .brand img {
    width: 56px;
    height: auto;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    font-size: 0.92rem;
  }

  .nav a {
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .nav a:hover {
    color: var(--green);
  }

  .nav-cta {
    padding: 0.65rem 1.1rem;
    border-radius: 999px;
    background: var(--pink);
    color: var(--green) !important;
    font-weight: 500;
  }

  .hero {
    position: relative;
    overflow: hidden;
    padding: 4.5rem 0 5rem;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 85% 15%, rgba(251, 218, 222, 0.9), transparent 42%),
      radial-gradient(circle at 10% 80%, rgba(251, 218, 222, 0.45), transparent 35%),
      var(--cream);
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3rem;
    align-items: center;
  }

  .hero-copy h1 {
    font-size: clamp(2.6rem, 5vw, 4.2rem);
    color: var(--green);
    max-width: 12ch;
    margin-bottom: 1.25rem;
  }

  .hero-lead {
    font-size: 1.08rem;
    color: var(--text-muted);
    max-width: 44ch;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero-card {
    background: var(--white);
    border: 1px solid rgba(20, 70, 46, 0.08);
    border-radius: calc(var(--radius) + 0.5rem);
    padding: 2.5rem 2rem;
    box-shadow: var(--shadow);
    text-align: center;
  }

  .hero-logo {
    width: min(220px, 70%);
    margin: 0 auto 1.5rem;
  }

  .hero-card-tag {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--green);
    margin-bottom: 0.75rem;
  }

  .hero-card-text {
    color: var(--text-muted);
    font-size: 0.98rem;
  }

  .about {
    padding: 5rem 0;
    background: var(--white);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 3rem;
    align-items: start;
  }

  .about-grid h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--green);
  }

  .about-copy {
    display: grid;
    gap: 1.25rem;
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .services {
    padding: 5rem 0;
    background: var(--pink);
  }

  .section-head {
    max-width: 620px;
    margin-bottom: 3rem;
  }

  .section-head h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--green);
    margin-bottom: 1rem;
  }

  .section-head p {
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .service-card {
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: var(--radius);
    padding: 2rem;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }

  .service-number {
    display: inline-block;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--green);
    opacity: 0.45;
    margin-bottom: 1rem;
  }

  .service-card h3 {
    font-size: 1.65rem;
    color: var(--green);
    margin-bottom: 0.75rem;
  }

  .service-card p {
    color: var(--text-muted);
  }

  .approach {
    padding: 5rem 0;
    background: var(--green);
    color: var(--white);
  }

  .approach-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .approach-panel h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 0.5rem 0 1.25rem;
  }

  .approach-panel p,
  .approach .section-label {
    color: rgba(255, 255, 255, 0.82);
  }

  .approach .section-label {
    color: var(--pink);
  }

  .value-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }

  .value-list li {
    padding: 1.1rem 1.25rem;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 1rem;
  }

  .contact {
    padding: 5rem 0;
    background: var(--cream);
  }

  .contact-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .contact-copy h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--green);
    margin: 0.5rem 0 1rem;
  }

  .contact-copy p {
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .contact-card {
    background: var(--white);
    border-radius: calc(var(--radius) + 0.25rem);
    padding: 2.25rem;
    box-shadow: var(--shadow);
    border: 1px solid rgba(20, 70, 46, 0.08);
  }

  .contact-label {
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--green);
    margin-bottom: 0.5rem;
  }

  .contact-email {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.75rem;
    color: var(--green);
    margin-bottom: 1rem;
  }

  .contact-note {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }

  .site-footer {
    padding: 2rem 0 2.5rem;
    background: var(--white);
    border-top: 1px solid rgba(20, 70, 46, 0.08);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer-inner p {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  @media (max-width: 900px) {
    .hero-grid,
    .about-grid,
    .service-grid,
    .approach-grid,
    .contact-inner {
      grid-template-columns: 1fr;
    }

    .nav {
      display: none;
    }

    .hero {
      padding-top: 2.5rem;
    }

    .hero-copy h1 {
      max-width: none;
    }
  }
</style>
